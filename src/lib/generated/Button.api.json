{
  "component": "Button",
  "props": [
    {
      "name": "variant",
      "type": "ButtonVariant",
      "optional": true,
      "default": "'ghost'"
    },
    {
      "name": "size",
      "type": "ButtonSize",
      "optional": true,
      "default": "'md'"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "optional": true,
      "default": "false"
    },
    {
      "name": "loading",
      "type": "boolean",
      "optional": true,
      "default": "false"
    },
    {
      "name": "href",
      "type": "string",
      "optional": true,
      "description": "When set, renders as `<a>`; otherwise renders as `<button>`."
    },
    {
      "name": "target",
      "type": "'_self' | '_blank' | '_parent' | '_top'",
      "optional": true,
      "description": "Anchor target — forwarded to `<a>` only."
    },
    {
      "name": "full",
      "type": "boolean",
      "optional": true,
      "description": "Stretches the button to fill its container.",
      "default": "false"
    },
    {
      "name": "type",
      "type": "'button' | 'submit' | 'reset'",
      "optional": true,
      "default": "'button'"
    },
    {
      "name": "class",
      "type": "string",
      "optional": true
    },
    {
      "name": "onclick",
      "type": "(e: MouseEvent) => void",
      "optional": true
    },
    {
      "name": "children",
      "type": "Snippet",
      "optional": false
    }
  ],
  "interfaces": []
}