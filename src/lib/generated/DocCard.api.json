{
  "component": "DocCard",
  "props": [
    {
      "name": "tag",
      "type": "string",
      "optional": false,
      "description": "Eyebrow label — e.g. \"ENG · 01\""
    },
    {
      "name": "title",
      "type": "string",
      "optional": false,
      "description": "Main card title"
    },
    {
      "name": "meta",
      "type": "string",
      "optional": true,
      "description": "Footer metadata line — e.g. \"DRAFT · 2026-05-13\""
    },
    {
      "name": "variant",
      "type": "DocCardColor",
      "optional": true,
      "description": "Accent color for the left edge bar, TR corner, and tag text",
      "default": "'accent'"
    },
    {
      "name": "status",
      "type": "DocCardStatus",
      "optional": true,
      "description": "Status controls the dot color in the meta row",
      "default": "'draft'"
    },
    {
      "name": "onclick",
      "type": "(e: MouseEvent) => void",
      "optional": true
    },
    {
      "name": "class",
      "type": "string",
      "optional": true
    },
    {
      "name": "metaSlot",
      "type": "Snippet",
      "optional": true,
      "description": "Optional override of the meta area"
    }
  ],
  "interfaces": []
}