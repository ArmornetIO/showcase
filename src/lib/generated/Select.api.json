{
  "component": "Select",
  "props": [
    {
      "name": "id",
      "type": "string",
      "optional": true
    },
    {
      "name": "name",
      "type": "string",
      "optional": true
    },
    {
      "name": "value",
      "type": "string",
      "optional": true,
      "default": "''",
      "description": "Bindable. The currently selected option value."
    },
    {
      "name": "options",
      "type": "SelectOption[]",
      "optional": true,
      "default": "[]",
      "description": "Flat list of options. Use `groups` instead when you need optgroup separators."
    },
    {
      "name": "groups",
      "type": "SelectOptGroup[]",
      "optional": true,
      "default": "[]",
      "description": "Grouped options rendered as <optgroup> elements. Ignored when `options` is used."
    },
    {
      "name": "placeholder",
      "type": "string",
      "optional": true,
      "description": "Rendered as a disabled first option prompting the user to select."
    },
    {
      "name": "disabled",
      "type": "boolean",
      "optional": true,
      "default": "false"
    },
    {
      "name": "required",
      "type": "boolean",
      "optional": true,
      "default": "false"
    },
    {
      "name": "class",
      "type": "string",
      "optional": true
    },
    {
      "name": "onchange",
      "type": "(e: Event & { currentTarget: HTMLSelectElement }) => void",
      "optional": true
    }
  ],
  "interfaces": [
    {
      "name": "SelectOption",
      "fields": [
        { "name": "value", "type": "string" },
        { "name": "label", "type": "string" },
        { "name": "disabled", "type": "boolean", "optional": true }
      ]
    },
    {
      "name": "SelectOptGroup",
      "fields": [
        { "name": "group", "type": "string" },
        { "name": "options", "type": "SelectOption[]" }
      ]
    }
  ]
}
