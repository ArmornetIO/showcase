{
  "component": "Canvas",
  "props": [
    {
      "name": "graph",
      "type": "CanvasGraph",
      "optional": false
    },
    {
      "name": "layout",
      "type": "'layered' | 'free'",
      "optional": true,
      "default": "'layered'"
    },
    {
      "name": "edgeCurve",
      "type": "'bezier' | 'line'",
      "optional": true
    },
    {
      "name": "layerOrder",
      "type": "string[]",
      "optional": true,
      "default": "['ui', 'api', 'core', 'agent', 'infra', 'docs']"
    },
    {
      "name": "filterNode",
      "type": "(n: CanvasNode) => boolean",
      "optional": true
    },
    {
      "name": "activeFlow",
      "type": "string | null",
      "optional": true,
      "default": "null"
    },
    {
      "name": "activeStep",
      "type": "number | null",
      "optional": true,
      "default": "null"
    },
    {
      "name": "onNodeSelect",
      "type": "(id: string | null) => void",
      "optional": true
    }
  ],
  "interfaces": [
    {
      "name": "Port",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "optional": false
        },
        {
          "name": "angle",
          "type": "number",
          "optional": false,
          "description": "Degrees. 0=right · 90=bottom · 180=left · 270=top."
        },
        {
          "name": "role",
          "type": "'in' | 'out' | 'inout'",
          "optional": false
        },
        {
          "name": "dataType",
          "type": "DataType",
          "optional": false
        }
      ]
    },
    {
      "name": "PortState",
      "fields": [
        {
          "name": "portId",
          "type": "string",
          "optional": false
        },
        {
          "name": "active",
          "type": "boolean",
          "optional": false
        },
        {
          "name": "flowRate",
          "type": "number",
          "optional": true,
          "description": "0–1. Drives animation intensity."
        }
      ]
    },
    {
      "name": "CanvasNode",
      "fields": [
        {
          "name": "id",
          "type": "string",
          "optional": false
        },
        {
          "name": "label",
          "type": "string",
          "optional": false,
          "description": "Primary label shown inside the node."
        },
        {
          "name": "sublabel",
          "type": "string",
          "optional": true
        },
        {
          "name": "badge",
          "type": "string",
          "optional": true,
          "description": "Short badge rendered at the top of the circle."
        },
        {
          "name": "value",
          "type": "string",
          "optional": true,
          "description": "Large center value."
        },
        {
          "name": "valueLabel",
          "type": "string",
          "optional": true,
          "description": "Smaller label beneath value."
        },
        {
          "name": "r",
          "type": "number",
          "optional": true,
          "description": "Circle radius. Mesh nodes default 52; arch nodes default 28."
        },
        {
          "name": "variant",
          "type": "CanvasNodeVariant",
          "optional": true,
          "description": "Arch-diagram variant (used when meshType is absent)."
        },
        {
          "name": "layer",
          "type": "string",
          "optional": true,
          "description": "Column key used in 'layered' layout."
        },
        {
          "name": "x",
          "type": "number",
          "optional": true,
          "description": "Fixed x position used in 'free' layout."
        },
        {
          "name": "y",
          "type": "number",
          "optional": true,
          "description": "Fixed y position used in 'free' layout."
        },
        {
          "name": "group",
          "type": "string",
          "optional": true,
          "description": "Groups this node into a named container box."
        },
        {
          "name": "animate",
          "type": "boolean",
          "optional": true
        },
        {
          "name": "popDelay",
          "type": "number",
          "optional": true
        },
        {
          "name": "tags",
          "type": "Record<string, string[]>",
          "optional": true
        },
        {
          "name": "description",
          "type": "string",
          "optional": true
        },
        {
          "name": "meta",
          "type": "Record<string, unknown>",
          "optional": true
        },
        {
          "name": "meshType",
          "type": "MeshNodeType",
          "optional": true
        },
        {
          "name": "nodeState",
          "type": "NodeState",
          "optional": true
        },
        {
          "name": "strokeColor",
          "type": "string",
          "optional": true,
          "description": "Override stroke color. Defaults to meshType palette."
        },
        {
          "name": "glowColor",
          "type": "string",
          "optional": true,
          "description": "Override glow color. Defaults to strokeColor."
        },
        {
          "name": "fillColor",
          "type": "string",
          "optional": true,
          "description": "Override fill color."
        },
        {
          "name": "liveSlot",
          "type": "string",
          "optional": true,
          "description": "Short live-state string rendered at node center (e.g. \"48ms\", \"12/min\")."
        },
        {
          "name": "portStates",
          "type": "PortState[]",
          "optional": true,
          "description": "Runtime active state per port — drives segmented ring + port indicators."
        }
      ]
    },
    {
      "name": "CanvasEdge",
      "fields": [
        {
          "name": "from",
          "type": "string",
          "optional": false
        },
        {
          "name": "to",
          "type": "string",
          "optional": false
        },
        {
          "name": "type",
          "type": "string",
          "optional": true,
          "description": "Semantic type — 'depends-on' drives flow topology."
        },
        {
          "name": "qualifier",
          "type": "string",
          "optional": true,
          "description": "'calls' edges render with a distinct dashed style."
        },
        {
          "name": "label",
          "type": "string",
          "optional": true
        },
        {
          "name": "fromPort",
          "type": "string",
          "optional": true,
          "description": "Named port on the source node. If absent, falls back to center-to-center."
        },
        {
          "name": "toPort",
          "type": "string",
          "optional": true,
          "description": "Named port on the target node. If absent, falls back to center-to-center."
        },
        {
          "name": "dataType",
          "type": "DataType",
          "optional": true
        },
        {
          "name": "active",
          "type": "boolean",
          "optional": true,
          "description": "Enables particle stream animation."
        },
        {
          "name": "particleCount",
          "type": "number",
          "optional": true,
          "description": "Override particle count (default 3)."
        }
      ]
    },
    {
      "name": "CanvasGraph",
      "fields": [
        {
          "name": "nodes",
          "type": "CanvasNode[]",
          "optional": false
        },
        {
          "name": "edges",
          "type": "CanvasEdge[]",
          "optional": false
        }
      ]
    },
    {
      "name": "ArchGraphIn",
      "fields": [
        {
          "name": "nodes",
          "type": "ArchNodeIn[]",
          "optional": false
        },
        {
          "name": "edges",
          "type": "ArchEdgeIn[]",
          "optional": false
        }
      ]
    }
  ]
}