{
	"extends": "./.svelte-kit/tsconfig.json",
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"test/**/*.js",
		"test/**/*.ts",
		"test/**/*.svelte",
		"tests/**/*.js",
		"tests/**/*.ts",
		"tests/**/*.svelte"
	],
	"compilerOptions": {
		// NO `paths` here, deliberately. `paths` in an extending config REPLACES
		// the parent's rather than merging, so declaring one mapping here silently
		// drops every mapping SvelteKit generates. Both project aliases live in
		// `kit.alias` in svelte.config.js instead, which writes them into
		// `.svelte-kit/tsconfig.json` next to the generated ones.
		//
		// `examples/**` is deliberately NOT in `include`: each example is a
		// standalone Vite app with `moduleResolution: "bundler"`, and checking it
		// under this project's `nodenext` reports errors that are not errors where
		// the code actually runs. Each example owns its own `npm run check`.
		"rewriteRelativeImportExtensions": true,
		"allowJs": true,
		"checkJs": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext"
	},
	"exclude": ["**/*.spec.ts", "**/*.test.ts", "node_modules"]
}
